# =========================================================
# PostgreSQL configuration
# =========================================================

# Database name used by QuadGPT
DB_NAME=quadgpt

# PostgreSQL application user
DB_USER=quadgpt

# Replace with a strong password in your local .env file
DB_PASSWORD=change_me


# =========================================================
# MinIO configuration
# =========================================================

# MinIO administrator username
MINIO_ROOT_USER=admin

# Replace with a strong password in your local .env file
MINIO_ROOT_PASSWORD=change_me


# =========================================================
# Authentication
# =========================================================

# Secret used for authentication token signing
JWT_SECRET=change_me


# =========================================================
# Local LLM configuration (Ollama)
# =========================================================

# Model name loaded by Ollama (e.g. qwen2.5:1.5b, qwen2.5-coder:7b)
OLLAMA_MODEL=qwen2.5:1.5b


DB_HOST=database
DB_PORT=5432

ZAI_API_KEY=ollama
ZAI_BASE_URL=http://host.docker.internal:11434/v1
ZAI_MODEL=qwen2.5:1.5b
