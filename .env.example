# =========================================================
# PostgreSQL configuration
# =========================================================

# Database name used by QuadGPT
DB_NAME=quadgpt

# PostgreSQL application user
DB_USER=quadgpt

# Replace with a strong password in your local .env file
DB_PASSWORD=change_me


# =========================================================
# MinIO configuration
# =========================================================

# MinIO administrator username
MINIO_ROOT_USER=admin

# Replace with a strong password in your local .env file
MINIO_ROOT_PASSWORD=change_me


# =========================================================
# Authentication
# =========================================================

# Secret used for authentication token signing
JWT_SECRET=change_me


# =========================================================
# External LLM provider
# =========================================================

# Optional GLM API key provided during the hackathon
# Never commit the real API key
GLM_API_KEY=